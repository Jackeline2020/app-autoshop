# Chave de assinatura dos tokens JWT
JWT_SECRET=autoshop-secret-dev

# Token secreto exigido no header X-Webhook-Token pelo endpoint de email
EMAIL_WEBHOOK_SECRET=autoshop-webhook-dev

# PostgreSQL — valores fixos para desenvolvimento local via docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoshop
DB_PASSWORD=autoshop
DB_NAME=autoshop
DB_SSLMODE=disable
