# Chave de assinatura dos tokens JWT
JWT_SECRET=autoshop-secret-dev

# Token secreto exigido no header X-Webhook-Token pelo endpoint de email
EMAIL_WEBHOOK_SECRET=autoshop-webhook-dev

# PostgreSQL — valores fixos para desenvolvimento local via docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoshop
DB_PASSWORD=autoshop
DB_NAME=autoshop
DB_SSLMODE=disable

# New Relic (observabilidade — Fase 3). Deixe em branco pra rodar sem APM
# (logs estruturados continuam funcionando normalmente). Pegue a license key
# em https://one.newrelic.com/admin-portal/api-keys/home (tier gratuito).
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=autoshop-api
